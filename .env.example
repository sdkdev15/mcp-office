# MCP Office Server Configuration

# Output directory for generated files
OUTPUT_DIR=outputs

# File retention (hours before auto-deletion)
FILE_RETENTION_HOURS=24

# Rate limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# MCP transport mode (stdio or sse)
MCP_TRANSPORT=stdio

# SSE mode settings
MCP_HOST=0.0.0.0
MCP_PORT=8765

# Locale (en_US, id_ID)
LOCALE=en_US

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO