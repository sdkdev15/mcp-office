# =========================
# App Configuration
# =========================
OUTPUT_DIR=/app/outputs
FILE_RETENTION_HOURS=24

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8765

LOCALE=en_US
LOG_LEVEL=INFO

# =========================
# S3 Storage Configuration
# =========================
S3_ENDPOINT=https://dcs3.psn.co.id
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# =========================
# Healthcheck
# =========================
HEALTHCHECK_URL=http://localhost:8765/sse
HC_INTERVAL=30s
HC_TIMEOUT=5s
HC_RETRIES=3
HC_START_PERIOD=10s

